extends SceneTree
var failures:Array[String]=[]
func _initialize() -> void:run.call_deferred()
func check(ok:bool,message:String) -> void:
    if not ok:
        failures.append(message)
        push_error(message)
func run() -> void:
    var game=load("res://scenes/levels/formal_hell_entry.tscn").instantiate()
    root.add_child(game)
    current_scene=game
    await process_frame
    game.get_node("WallEntry").reset_for_replay()
    game.get_node("WallEntry").completed=true
    game.get_node("FlyingEnemies").enabled=false
    var stage=game.get_node("OceanLink/FishStage")
    stage.activate()
    stage.host.take_control()
    stage._on_transfer_finished(stage.host)
    stage.set_physics_process(false)
    var fish=stage.fish
    fish.get_node("Movement").enabled=false
    var pacing=stage.get_node("Pacing")
    for node in ["Shark","Octopus","BossTentacleNet","JellyfishBoss","SideTentacle","FinalSharks"]:stage.get_node(node).set_physics_process(false)
    stage.get_node("JellyfishReveal").set_process(false)
    for lane in stage.get_node("PinkSharks").get_children():lane.set_physics_process(false)
    var shark=stage.get_node("Shark")
    var pink=stage.get_node("PinkSharks")
    var octopus=stage.get_node("Octopus")
    var ink=stage.get_node("InkOverlay")
    fish.global_position=game.to_global(Vector2(960,38800))
    game.camera.set_follow_target(fish,true)
    pacing.update(0,true,38800)
    check(pink.get_child(0).running and pink.get_child(1).running,"Early zone has two pink shark encounters")
    check(not pink.get_child(2).running and not pink.get_child(3).running,"Later duplicate pink rows are retired")
    check(not shark.enabled and not octopus.enabled,"Early zone excludes octopus and pursuit shark")
    pink.get_child(0)._physics_process(.016)
    check(pink.get_child(0).started,"Early pink wave can really enter from view edge")
    fish.global_position=game.to_global(Vector2(960,35000))
    pacing.update(0,true,35000)
    check(octopus.enabled and not shark.enabled,"Middle zone belongs to octopus")
    check(pink.get_children().all(func(lane):return not lane.started and not lane.running),"Pink waves clear before middle zone")
    octopus.visitors[0].state=octopus.visitors[0].State.SWIMMING
    pacing.update(0,true,35000)
    check(not octopus.spawn_allowed and not stage.get_node("BossTentacleNet").enabled,"Existing octopus visit prevents stacked visitor and tentacle attacks")
    ink.splash()
    fish.global_position=game.to_global(Vector2(960,33000))
    pacing.update(0,true,33000)
    check(not shark.enabled,"Ink carried into later zone postpones pursuit shark")
    ink.reset()
    pacing.update(0,true,33000)
    check(shark.enabled and not octopus.enabled,"Clear later zone enables skinny pursuit shark")
    shark._begin_lock()
    check(shark.state==shark.State.LOCKING,"Pursuit shark can start its real telegraph")
    var stun=fish.get_node("Stun")
    check(stun.apply(Vector2.RIGHT),"Fixture receives actual tentacle stun")
    pacing.update(0,true,33000)
    check(not shark.enabled and shark.state==shark.State.WAITING,"Stun cancels incoming pursuit attack")
    await create_timer(.95).timeout
    pacing.update(.95,true,33000)
    check(stun.stun_remaining<=0 and pacing.rest_remaining>0,"Recovery retains time to swim away")
    check(not pacing.damage_allowed(),"Recovery blocks a second punishment")
    stage._on_ink_sprayed()
    check(not ink.visible,"Recovery also prevents a second ink punishment")
    pacing.update(3,true,33000)
    check(shark.enabled,"Pursuit resumes after recovery rest")
    var point=game.get_node("OceanCheckpoint")
    point.activate()
    fish.global_position=point.global_position+Vector2(-155,0)
    pacing.update(0,true,32300)
    check(not shark.enabled,"Checkpoint activation grants breathing room")
    pacing.update(4,true,32300)
    check(not shark.enabled,"Checkpoint bubble neighborhood remains safe")
    fish.global_position=game.to_global(Vector2(960,31900))
    pacing.update(0,true,31900)
    check(shark.enabled,"Leaving checkpoint area resumes later challenge")
    pacing.showcase_remaining=2
    pacing.update(0,true,31900)
    check(not shark.enabled,"Jellyfish reveal gets a clear showcase")
    pacing.update(3,true,31900)
    fish.global_position=game.to_global(Vector2(960,31000))
    fish.velocity=Vector2(0,-100)
    ink.splash()
    stage.get_node("FinalSharks")._physics_process(0)
    check(not stage.get_node("FinalSharks").triggered,"Final trio waits for ink to clear")
    ink.reset()
    pacing.update(0,true,31000)
    stage.get_node("FinalSharks")._physics_process(0)
    check(stage.get_node("FinalSharks").triggered,"Final trio starts when player can see and act")
    pacing.update(0,true,31000)
    check(not shark.enabled and not octopus.enabled and not pacing.side_tentacle_allowed and stage.get_node("BossTentacleNet").rows.is_empty(),"Final trio has the stage to itself")
    stage.get_node("ShoreExit").state=stage.get_node("ShoreExit").State.STRANDED
    check(not pacing.damage_allowed(),"Leaving water ends attack damage")
    stage.reset()
    check(pacing.rest_remaining==0 and pacing.showcase_remaining==0,"Retry clears pacing timers")
    print("OCEAN_ENCOUNTER_PACING_FAILURES=",failures.size())
    quit(0 if failures.is_empty() else 1)
